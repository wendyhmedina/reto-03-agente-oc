# Proveedor del modelo: gemini (gratis, recomendado) | groq (gratis) | anthropic | openai
LLM_PROVIDER=gemini
# Opcional: modelo del proveedor. Por defecto gemini-2.5-flash / llama-3.3-70b-versatile / claude-haiku-4-5 / gpt-4.1-mini
LLM_MODEL=
# Solo necesitas la clave del proveedor elegido. Nunca la subas al repositorio.
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Timeout por llamada al modelo (ms)
LLM_TIMEOUT_MS=60000
# Tope de iteraciones herramienta -> modelo por turno (CA1)
MAX_ITERACIONES=25
# Tope de tokens (entrada + salida) por sesión
MAX_TOKENS_SESION=300000
# Puerto HTTP
PORT=3000
# Opcional: si se define, el chat pide esta clave de acceso (header x-access-key)
APP_ACCESS_KEY=
