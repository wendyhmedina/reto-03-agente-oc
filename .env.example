# Proveedor del modelo: anthropic | openai
LLM_PROVIDER=anthropic
# Modelo del proveedor elegido (ej. claude-haiku-4-5, gpt-4.1-mini)
LLM_MODEL=
# Clave del proveedor elegido (solo una es necesaria). Nunca la subas al repositorio.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Timeout por llamada al modelo (ms)
LLM_TIMEOUT_MS=60000
# Tope de iteraciones herramienta -> modelo por turno (CA1)
MAX_ITERACIONES=25
# Tope de tokens (entrada + salida) por sesión
MAX_TOKENS_SESION=300000
# Puerto HTTP
PORT=3000
# Opcional: si se define, el chat pide esta clave de acceso (header x-access-key)
APP_ACCESS_KEY=
